# Local example. On Railway, reference the Postgres service DATABASE_URL.
DATABASE_URL=postgresql://USER:PASSWORD@HOST:PORT/DATABASE
APP_ENV=development
# Comma-separated frontend origins, including the scheme and no trailing slash.
APP_ORIGIN=http://localhost:5173
# Comma-separated hostnames only; do not include https:// or paths.
ALLOWED_HOSTS=localhost,127.0.0.1
# Use none for separately hosted HTTPS frontend/backend services.
COOKIE_SAMESITE=lax
